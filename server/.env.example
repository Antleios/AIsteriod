DATABASE_URL="file:./dev.db"
PORT=3001
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:3000"
AUTH_SESSION_TTL_DAYS=7
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_REGISTER_MAX_ATTEMPTS=5
# Optional development-only override used by `npm run db:seed:demo`.
SAMPLE_ACCOUNT_PASSWORD="Aisteriod-2026!"
# Patient chat and speech use live Qwen APIs. Fill QWEN_API_KEY before use.
# Set AI_INTERACTION_PROVIDER=deterministic and TTS_PROVIDER=browser only for explicit offline demos.
AI_INTERACTION_PROVIDER="qwen"
AI_DOCTOR_PROVIDER="deterministic"
AI_MEMORY_PROVIDER="deterministic"
# Prompt versions are selected server-side. Add a version in
# src/services/aiPrompts.js before changing either value.
AI_INTERACTION_PROMPT_VERSION="patient-interaction-v2"
AI_DOCTOR_PROMPT_VERSION="session-summary-v1"
AI_MEMORY_PROMPT_VERSION="session-conversation-memory-v1"
QWEN_API_KEY=""
QWEN_CHARACTER_MODEL="qwen-plus"
QWEN_DOCTOR_MODEL="qwen-plus"
QWEN_MEMORY_MODEL="qwen-plus"
# Optional OpenAI-compatible API base URL. `/chat/completions` is added automatically.
QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
TTS_PROVIDER="qwen"
QWEN_TTS_MODEL="qwen3-tts-instruct-flash"
QWEN_TTS_VOICE="Cherry"
QWEN_TTS_URL="https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation"
